---
// Адмінка: одна мова (українська), бо нею користуються власник і менеджери, а не покупці.
import '../styles/global.css';
import '../styles/admin.css';
import Logo from '../components/Logo.astro';

interface Props { title: string }
const { title } = Astro.props;
const NAV = [
  { href: '/admin/', label: 'Головна' },
  { href: '/admin/requests/', label: 'Заявки' },
  { href: '/admin/products/', label: 'Товари' },
  { href: '/admin/categories/', label: 'Категорії' },
  { href: '/admin/banners/', label: 'Банери' },
  { href: '/admin/reviews/', label: 'Відгуки' },
  { href: '/admin/promotions/', label: 'Акції', ownerOnly: true },
  { href: '/admin/stats/', label: 'Статистика', ownerOnly: true },
];
const path = Astro.url.pathname;
const current = (href: string) => (href === '/admin/' ? path === '/admin/' : path.startsWith(href));
---
<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Адмінка ABAWKA</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="admin">
    <header class="admin-bar">
      <div class="wrap admin-bar-in">
        <a href="/admin/" class="brand"><Logo /><span class="tag">адмінка</span></a>
        <nav class="admin-nav" aria-label="Розділи адмінки" data-who-nav hidden>
          {/* ownerOnly: показує requireStaff() лише власнику */}
          {NAV.map((n) => <a href={n.href} aria-current={current(n.href) ? 'page' : undefined} data-owner-only={n.ownerOnly || undefined} hidden={n.ownerOnly || undefined}>{n.label}</a>)}
        </nav>
        <div class="who" data-who hidden>
          <span data-who-email></span>
          <button type="button" class="publish" data-publish title="Зміни з адмінки з'являться на сайті за 1–2 хвилини">Оновити сайт</button>
          <button type="button" class="logout" data-logout>Вийти</button>
        </div>
      </div>
    </header>
    <main class="wrap admin-main">
      <p class="publish-msg" role="status" data-publish-msg></p>
      <slot />
    </main>
    <script>
      import { supabase } from '../lib/supabase-client';

      // «Оновити сайт»: сайт статичний, тож зміни з адмінки потрапляють на нього після перезбірки на Netlify.
      const btn = document.querySelector<HTMLButtonElement>('[data-publish]');
      const out = document.querySelector<HTMLElement>('[data-publish-msg]')!;
      btn?.addEventListener('click', async () => {
        if (!supabase) return;
        btn.disabled = true;
        out.textContent = 'Запускаємо оновлення…';
        const { data, error } = await supabase.functions.invoke('publish').catch(() => ({ data: null, error: {} as { context?: Response } }));
        btn.disabled = false;
        if (!error) {
          out.textContent = data?.throttled
            ? 'Оновлення вже запущене щойно — зачекайте 1–2 хвилини.'
            : 'Сайт оновлюється ✓ Зміни з’являться за 1–2 хвилини.';
          return;
        }
        const status = (error as { context?: Response }).context?.status;
        out.textContent = status === 503
          ? 'Сайт ще не підключено до хостингу — оновлення запрацює після запуску.'
          : 'Не вдалося запустити оновлення. Спробуйте ще раз за хвилину.';
      });
    </script>
  </body>
</html>

<style>
  .admin { background: var(--bg-soft); min-height: 100vh; }
  .admin-bar { background: var(--surface); border-bottom: 1px solid var(--line); }
  .admin-bar-in { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 12px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; }
  .tag { padding: 2px 10px; border-radius: 999px; background: var(--accent-soft); color: var(--accent-text); font-weight: 800; font-size: 13px; }
  .admin-nav { display: flex; gap: 4px; margin-right: auto; margin-left: 12px; }
  .admin-nav[hidden] { display: none; }
  .admin-nav a { padding: 8px 14px; border-radius: 999px; font-weight: 800; color: var(--ink-2); }
  .admin-nav a:hover { background: var(--accent-soft); color: var(--accent-text); }
  .admin-nav a[aria-current] { background: var(--accent-soft); color: var(--accent-text); }
  .who { display: flex; align-items: center; gap: 12px; font-weight: 700; color: var(--ink-2); min-width: 0; }
  .who[hidden] { display: none; }
  .who span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Пунктів меню багато: на екранах до 1500px email ховаємо, лишаємо «Оновити сайт» і «Вийти». */
  @media (max-width: 1500px) { .who span { display: none; } }
  .publish { border: 2px solid var(--accent-border); background: var(--accent-soft); color: var(--accent-text); border-radius: 999px; padding: 6px 14px; font-weight: 800; cursor: pointer; flex: none; }
  .publish:disabled { opacity: 0.6; cursor: default; }
  .publish-msg { margin: 0 0 12px; font-weight: 700; color: var(--ink-2); }
  .publish-msg:empty { display: none; }
  .logout { border: 2px solid var(--line); background: var(--surface); border-radius: 999px; padding: 6px 14px; font-weight: 800; cursor: pointer; flex: none; }
  .logout:hover { border-color: var(--pink-500); color: var(--accent-text); }
  .admin-main { padding-block: 32px 64px; }
  /* До 1360px меню не влазить в один рядок з кнопками — переносимо його під лого. */
  @media (max-width: 1360px) {
    .admin-bar-in { flex-wrap: wrap; }
    .admin-nav { order: 3; width: 100%; margin: 0; overflow-x: auto; }
  }
</style>

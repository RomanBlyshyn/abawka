---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Службові сторінки (кошик, «Дякуємо») не потрібні в пошуку. */
  noindex?: boolean;
}
const { locale, title, description, noindex = false } = Astro.props;
const t = useTranslations(locale);
const rest = Astro.url.pathname.split('/').slice(2).join('/');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ABAWKA</title>
    <meta name="description" content={description ?? t('meta.description')} />
    <script is:inline>
      // До першого малювання: збережений вибір або тема системи. Інакше темна тема блимала б білим.
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="theme-color" content="#d6246e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/${rest}`, Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(`/${rest}`, Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <div class="toast" role="status" aria-live="polite" data-toast hidden>
      <span>{t('cart.added')}</span>
      <a href={`/${locale}/cart/`}>{t('cart.goTo')} →</a>
    </div>

    <script>
      import { addToCart, cartCount, CART_EVENT } from '../lib/cart-client';

      const counter = document.querySelector<HTMLElement>('[data-cart-count]');
      const renderCount = () => {
        if (!counter) return;
        const n = cartCount();
        counter.textContent = String(n);
        counter.hidden = n === 0;
      };
      renderCount();
      window.addEventListener(CART_EVENT, renderCount);
      window.addEventListener('storage', (e) => { if (e.key === 'cart') renderCount(); }); // інша вкладка

      const toast = document.querySelector<HTMLElement>('[data-toast]')!;
      let hideTimer: ReturnType<typeof setTimeout>;
      const showToast = () => {
        toast.hidden = false;
        clearTimeout(hideTimer);
        hideTimer = setTimeout(() => (toast.hidden = true), 4000);
      };

      // Делегування: працює для всіх кнопок «У кошик» на будь-якій сторінці.
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element).closest<HTMLButtonElement>('[data-add-to-cart]');
        if (!btn) return;
        const qtyInput = btn.dataset.qtyInput ? document.querySelector<HTMLInputElement>(btn.dataset.qtyInput) : null;
        const qty = Math.max(1, Math.floor(Number(qtyInput?.value) || 1));
        addToCart(btn.dataset.addToCart!, qty, Number(btn.dataset.stock) || 1);
        showToast();
      });
    </script>
  </body>
</html>

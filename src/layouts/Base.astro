---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LOCALES, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
}
const { locale, title, description } = Astro.props;
const t = useTranslations(locale);
const rest = Astro.url.pathname.split('/').slice(2).join('/');
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ABAWKA</title>
    <meta name="description" content={description ?? t('meta.description')} />
    <meta name="theme-color" content="#d6246e" />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(`/${l}/${rest}`, Astro.site)} />)}
  </head>
  <body>
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

---
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · ABAWKA</title>
  </head>
  <body>
    <slot />
  </body>
</html>

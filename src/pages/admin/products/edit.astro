---
import Admin from '../../../layouts/Admin.astro';
import { LOCALES, LOCALE_NAMES } from '../../../i18n/config';
---
<Admin title="Товар">
  <p class="state" data-state="loading">Завантаження…</p>
  <div class="alert" role="alert" data-state="notfound" hidden>
    Товар не знайдено — можливо, його вже видалили. <a href="/admin/products/">До списку товарів</a>
  </div>

  <form class="editor" data-state="form" data-form novalidate hidden>
    <div class="top">
      <a class="back" href="/admin/products/">← Товари</a>
      <h1 data-title>Новий товар</h1>
      <span class="saved" role="status" data-saved></span>
    </div>

    <div class="alert" role="alert" tabindex="-1" data-error hidden></div>

    <!-- Назва й опис -->
    <section class="card" aria-labelledby="t-text">
      <h2 id="t-text">Назва й опис</h2>
      <p class="hint">Пишіть однією мовою, а кнопка «Перекласти» заповнить решту. Будь-який переклад можна поправити вручну.</p>
      <div class="tabs" role="tablist" aria-label="Мова">
        {LOCALES.map((l) => (
          <button type="button" role="tab" data-lang={l} aria-selected={l === 'uk' ? 'true' : 'false'} title={LOCALE_NAMES[l]}>
            {l.toUpperCase()}<span class="dot" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <label for="name">Назва <span class="lang-label" data-lang-label></span></label>
      <input id="name" type="text" maxlength="120" data-field="name" />
      <p class="err" data-err="name" hidden></p>
      <label for="description">Опис <span class="lang-label" data-lang-label></span></label>
      <textarea id="description" rows="6" maxlength="5000" data-field="description"></textarea>
      <div class="translate-row">
        <button type="button" class="btn btn-light" data-translate>Перекласти на інші мови</button>
        <span class="hint">з мови: <b data-lang-label></b></span>
        <span class="hint" role="status" data-translate-status></span>
      </div>
    </section>

    <!-- Ціна й наявність -->
    <section class="card" aria-labelledby="t-price">
      <h2 id="t-price">Ціна й наявність</h2>
      <div class="grid">
        <div>
          <label for="price">Ціна, €</label>
          <input id="price" type="text" inputmode="decimal" placeholder="19,99" data-price />
          <p class="err" data-err="price" hidden></p>
        </div>
        <div>
          <label for="old_price">Стара ціна, € <span class="opt">(для знижки)</span></label>
          <input id="old_price" type="text" inputmode="decimal" placeholder="—" data-old-price />
          <p class="hint" data-discount></p>
          <p class="err" data-err="old_price" hidden></p>
        </div>
        <div>
          <label for="stock">Кількість на складі</label>
          <input id="stock" type="number" inputmode="numeric" min="0" step="1" data-stock />
          <p class="err" data-err="stock" hidden></p>
        </div>
        <div>
          <label for="age">Вік, від (років)</label>
          <input id="age" type="number" inputmode="numeric" min="0" max="18" step="1" data-age />
          <p class="err" data-err="age" hidden></p>
        </div>
      </div>
    </section>

    <!-- Категорія й показ -->
    <section class="card" aria-labelledby="t-cat">
      <h2 id="t-cat">Категорія й показ на сайті</h2>
      <label for="category">Категорія</label>
      <select id="category" data-category></select>
      <p class="err" data-err="category" hidden></p>
      <div class="checks">
        <label class="check"><input type="checkbox" data-published /> Показувати на сайті</label>
        <label class="check"><input type="checkbox" data-hit /> Позначка «Хіт»</label>
        <label class="check"><input type="checkbox" data-new /> Позначка «Новинка»</label>
      </div>
    </section>

    <!-- Адреса -->
    <details class="card advanced">
      <summary>Адреса сторінки (необов'язково)</summary>
      <label for="slug">Частина адреси після <code>/product/</code></label>
      <input id="slug" type="text" maxlength="80" data-slug />
      <p class="hint" data-slug-hint>Заповнюється сама з назви. Латиниця, цифри й дефіси.</p>
      <p class="err" data-err="slug" hidden></p>
    </details>

    <div class="bar">
      <button class="btn" type="submit" data-save>Зберегти</button>
      <button class="danger" type="button" data-delete hidden>Видалити товар</button>
    </div>
  </form>
</Admin>

<script>
  import { requireStaff, supabase, parseMoney, formatMoney, slugify, dbError, translate, guardUnsaved, ADMIN_LANGS, LANG_NAMES, type Localized } from '../../../lib/admin';
  import type { Locale } from '../../../i18n/config';

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const states = [...document.querySelectorAll<HTMLElement>('[data-state]')];
  const show = (name: string) => states.forEach((s) => (s.hidden = s.dataset.state !== name));

  const id = new URLSearchParams(location.search).get('id');
  const text: { name: Localized; description: Localized } = { name: {}, description: {} };
  let lang: Locale = 'uk';
  let slugTouched = Boolean(id); // для нового товару адреса береться з назви, доки її не змінили руками
  let snapshot = '';

  const f = {
    name: $<HTMLInputElement>('#name'),
    description: $<HTMLTextAreaElement>('#description'),
    price: $<HTMLInputElement>('[data-price]'),
    oldPrice: $<HTMLInputElement>('[data-old-price]'),
    stock: $<HTMLInputElement>('[data-stock]'),
    age: $<HTMLInputElement>('[data-age]'),
    category: $<HTMLSelectElement>('[data-category]'),
    published: $<HTMLInputElement>('[data-published]'),
    hit: $<HTMLInputElement>('[data-hit]'),
    isNew: $<HTMLInputElement>('[data-new]'),
    slug: $<HTMLInputElement>('[data-slug]'),
  };

  const clean = (t: Localized) => Object.fromEntries(Object.entries(t).map(([k, v]) => [k, v?.trim()]).filter(([, v]) => v)) as Localized;
  const state = () => JSON.stringify([clean(text.name), clean(text.description), f.price.value, f.oldPrice.value, f.stock.value, f.age.value,
    f.category.value, f.published.checked, f.hit.checked, f.isNew.checked, f.slug.value]);
  const dirty = () => snapshot !== '' && state() !== snapshot;
  const markSaved = (msg: string) => { snapshot = state(); $('[data-saved]').textContent = msg; };

  // ── Мовні вкладки ──────────────────────────────────────────────────────────
  function renderLang() {
    // Лише якщо змінилось — інакше курсор стрибав би в кінець під час набору.
    const n = text.name[lang] ?? '';
    const d = text.description[lang] ?? '';
    if (f.name.value !== n) f.name.value = n;
    if (f.description.value !== d) f.description.value = d;
    document.querySelectorAll('[data-lang-label]').forEach((e) => (e.textContent = LANG_NAMES[lang]));
    document.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((b) => {
      const l = b.dataset.lang as Locale;
      b.setAttribute('aria-selected', String(l === lang));
      b.classList.toggle('filled', Boolean(text.name[l]?.trim()));
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-lang]').forEach((b) => b.addEventListener('click', () => {
    lang = b.dataset.lang as Locale;
    renderLang();
  }));
  f.name.addEventListener('input', () => {
    text.name[lang] = f.name.value;
    if (!slugTouched) f.slug.value = slugify(text.name.en || text.name[lang] || '');
    renderLang();
    updateStatus();
  });
  f.description.addEventListener('input', () => { text.description[lang] = f.description.value; updateStatus(); });
  f.slug.addEventListener('input', () => { slugTouched = true; });

  // ── Переклад ───────────────────────────────────────────────────────────────
  $('[data-translate]').addEventListener('click', async () => {
    const status = $('[data-translate-status]');
    const source: Record<string, string> = {};
    if (text.name[lang]?.trim()) source.name = text.name[lang]!.trim();
    if (text.description[lang]?.trim()) source.description = text.description[lang]!.trim();
    if (!source.name) { status.textContent = `Спершу напишіть назву мовою «${LANG_NAMES[lang]}».`; return; }

    const others = ADMIN_LANGS.filter((l) => l !== lang);
    const empty = others.filter((l) => !text.name[l]?.trim());
    let targets = empty;
    if (!empty.length) {
      if (!confirm(`Усі мови вже заповнені. Перекласти заново з мови «${LANG_NAMES[lang]}»? Ручні правки в інших мовах буде замінено.`)) return;
      targets = others;
    }
    const btn = $<HTMLButtonElement>('[data-translate]');
    btn.disabled = true;
    status.textContent = 'Перекладаємо…';
    try {
      const result = await translate(lang, source, targets);
      for (const l of targets) {
        if (result[l]?.name) text.name[l] = result[l].name;
        if (result[l]?.description) text.description[l] = result[l].description;
      }
      status.textContent = `Готово: ${targets.length} мов. Перевірте й збережіть.`;
      renderLang();
      updateStatus();
    } catch {
      status.textContent = 'Переклад зараз недоступний. Мови можна заповнити вручну.';
    } finally {
      btn.disabled = false;
    }
  });

  // ── Знижка наживо ──────────────────────────────────────────────────────────
  function showDiscount() {
    const p = parseMoney(f.price.value);
    const o = parseMoney(f.oldPrice.value);
    $('[data-discount]').textContent = p && o && o > p ? `На сайті: знижка −${Math.round((1 - p / o) * 100)}%, стара ціна закреслена.` : '';
  }
  f.price.addEventListener('input', showDiscount);
  f.oldPrice.addEventListener('input', showDiscount);

  // ── Перевірка ─────────────────────────────────────────────────────────────
  function validate(): Record<string, string> {
    const e: Record<string, string> = {};
    if (!Object.values(clean(text.name)).length) e.name = 'Вкажіть назву хоча б однією мовою.';
    const p = parseMoney(f.price.value);
    if (p === null || Number.isNaN(p) || p <= 0) e.price = 'Вкажіть ціну, наприклад 19,99.';
    const o = parseMoney(f.oldPrice.value);
    if (o !== null && (Number.isNaN(o) || (p && o <= p))) e.old_price = 'Стара ціна має бути більшою за нову — або залиште поле порожнім.';
    const s = Number(f.stock.value);
    if (f.stock.value === '' || !Number.isInteger(s) || s < 0) e.stock = 'Ціле число від 0.';
    const a = Number(f.age.value);
    if (f.age.value === '' || !Number.isInteger(a) || a < 0 || a > 18) e.age = 'Ціле число від 0 до 18.';
    if (!f.category.value) e.category = 'Оберіть категорію.';
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(f.slug.value)) e.slug = 'Лише малі латинські літери, цифри й дефіси, наприклад toy-sword.';
    return e;
  }
  function showErrors(e: Record<string, string>) {
    document.querySelectorAll<HTMLElement>('[data-err]').forEach((el) => {
      const msg = e[el.dataset.err!];
      el.hidden = !msg;
      el.textContent = msg ?? '';
    });
    if (e.slug) ($('.advanced') as HTMLDetailsElement).open = true;
  }
  const say = (msg: string) => { const a = $('[data-error]'); a.textContent = msg; a.hidden = !msg; if (msg) a.focus(); };

  function updateStatus() {
    if (snapshot) $('[data-saved]').textContent = dirty() ? 'Є незбережені зміни' : 'Збережено ✓';
  }
  $('[data-form]').addEventListener('input', updateStatus);
  $('[data-form]').addEventListener('change', updateStatus);
  guardUnsaved(dirty);

  // ── Збереження ─────────────────────────────────────────────────────────────
  $<HTMLFormElement>('[data-form]').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const errors = validate();
    showErrors(errors);
    if (Object.keys(errors).length) {
      say('Перевірте поля, позначені червоним.');
      return;
    }
    say('');
    const row = {
      slug: f.slug.value,
      name: clean(text.name),
      description: clean(text.description),
      price: parseMoney(f.price.value)!,
      old_price: parseMoney(f.oldPrice.value),
      stock: Number(f.stock.value),
      age_min: Number(f.age.value),
      category_id: f.category.value,
      published: f.published.checked,
      hit: f.hit.checked,
      is_new: f.isNew.checked,
    };
    const btn = $<HTMLButtonElement>('[data-save]');
    btn.disabled = true;
    btn.textContent = 'Зберігаємо…';
    const res = id
      ? await supabase!.from('products').update(row).eq('id', id).select('id').single()
      : await supabase!.from('products').insert(row).select('id').single();
    btn.disabled = false;
    btn.textContent = 'Зберегти';
    if (res.error) return say(dbError(res.error));
    markSaved('Збережено ✓');
    if (!id) {
      // Новий товар став звичайним: далі зберігаємо як редагування.
      snapshot = '';
      location.replace(`/admin/products/edit/?id=${res.data.id}&created=1`);
    } else {
      $('[data-title]').textContent = row.name.uk || Object.values(row.name)[0]!;
    }
  });

  // ── Видалення ──────────────────────────────────────────────────────────────
  $('[data-delete]').addEventListener('click', async () => {
    const name = text.name.uk || Object.values(clean(text.name))[0] || 'цей товар';
    if (!confirm(`Видалити «${name}» назавжди? Фото й відгуки цього товару теж буде видалено.`)) return;
    const { error } = await supabase!.from('products').delete().eq('id', id!);
    if (error) return say(dbError(error));
    snapshot = '';
    location.assign('/admin/products/?deleted=1');
  });

  // ── Завантаження ───────────────────────────────────────────────────────────
  async function load() {
    const cats = await supabase!.from('categories').select('id,name').order('position');
    if (cats.error) return say(dbError(cats.error));
    f.category.replaceChildren(new Option('— оберіть —', ''),
      ...cats.data.map((c) => new Option((c.name as Localized).uk || Object.values(c.name as Localized)[0] || '', c.id)));

    if (id) {
      const { data, error } = await supabase!.from('products').select('*').eq('id', id).maybeSingle();
      if (error) { show('form'); return say(dbError(error)); }
      if (!data) return show('notfound');
      text.name = { ...data.name };
      text.description = { ...data.description };
      f.price.value = formatMoney(data.price);
      f.oldPrice.value = formatMoney(data.old_price);
      f.stock.value = String(data.stock);
      f.age.value = String(data.age_min);
      f.category.value = data.category_id;
      f.published.checked = data.published;
      f.hit.checked = data.hit;
      f.isNew.checked = data.is_new;
      f.slug.value = data.slug;
      $('[data-title]').textContent = data.name.uk || Object.values(data.name as Localized)[0] || 'Товар';
      $('[data-delete]').hidden = false;
      $('[data-slug-hint]').textContent = 'Увага: якщо змінити адресу, старі посилання на товар перестануть працювати.';
      if (!data.name[lang]) lang = (Object.keys(data.name)[0] as Locale) ?? 'uk';
    } else {
      f.stock.value = '0';
      f.age.value = '3';
      f.published.checked = true;
    }
    renderLang();
    showDiscount();
    show('form');
    snapshot = state();
    if (new URLSearchParams(location.search).get('created')) $('[data-saved]').textContent = 'Товар створено ✓';
  }

  requireStaff().then(load).catch(() => {});
</script>

<style>
  [data-state][hidden] { display: none; }
  .state { color: var(--ink-2); font-weight: 700; }
  .editor { display: grid; gap: 16px; max-width: 820px; margin-inline: auto; padding-bottom: 80px; }
  .top { display: grid; gap: 4px; }
  .back { color: var(--accent-text); font-weight: 800; }
  h1 { font-size: 28px; font-weight: 900; overflow-wrap: anywhere; }
  .saved { min-height: 1.5em; font-weight: 700; color: var(--ink-2); }
  .card { padding: 22px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); display: grid; gap: 8px; }
  .card h2 { font-size: 19px; }
  label { font-weight: 800; margin-top: 6px; }
  .opt, .lang-label { color: var(--ink-2); font-weight: 600; }
  .hint { margin: 0; font-size: 14px; color: var(--ink-2); font-weight: 600; }
  .hint:empty { display: none; }
  .err { margin: 0; font-size: 14px; font-weight: 700; color: var(--sale); }
  .err[hidden] { display: none; }
  input[type='text'], input[type='number'], select, textarea {
    width: 100%; min-height: 46px; padding: 10px 14px; border: 2px solid var(--line); border-radius: 12px; background: var(--surface); font-weight: 600;
  }
  textarea { resize: vertical; line-height: 1.5; }
  input:focus, select:focus, textarea:focus { border-color: var(--pink-500); outline: none; }

  .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .tabs button {
    position: relative; min-width: 48px; min-height: 38px; padding: 4px 12px; border: 2px solid var(--line); border-radius: 999px;
    background: var(--surface); font-weight: 800; cursor: pointer;
  }
  .tabs button[aria-selected='true'] { border-color: var(--pink-600); background: var(--accent-soft); color: var(--accent-text); }
  .dot { position: absolute; top: 4px; right: 5px; width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
  .tabs .filled .dot { background: var(--green); }
  .translate-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  .translate-row .btn { border: 2px solid var(--accent-border); }

  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; }
  .grid > div { display: grid; gap: 6px; align-content: start; }
  .checks { display: grid; gap: 6px; margin-top: 8px; }
  .check { display: flex; align-items: center; gap: 10px; font-weight: 700; margin: 0; cursor: pointer; }
  .check input { width: 22px; height: 22px; accent-color: var(--pink-600); }
  .advanced summary { font-weight: 800; cursor: pointer; }
  .alert { padding: 12px 16px; border-radius: var(--radius-sm); background: var(--tint-red); border: 2px solid var(--tint-red-border); font-weight: 700; }
  .alert[hidden] { display: none; }

  .bar {
    position: sticky; bottom: 0; display: flex; justify-content: space-between; gap: 12px; padding: 14px 0;
    background: linear-gradient(transparent, var(--bg-soft) 30%);
  }
  .bar .btn { flex: 0 1 220px; min-height: 50px; font-size: 17px; }
  .danger { white-space: nowrap; border: 2px solid var(--tint-red-border); background: var(--surface); color: var(--sale); border-radius: 999px; padding: 10px 18px; font-weight: 800; cursor: pointer; }
  .danger[hidden] { display: none; }
  .danger:hover { background: var(--tint-red); }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } .card { padding: 16px; } }
</style>

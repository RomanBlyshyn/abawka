---
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Заявки">
  <div class="head">
    <h1>Заявки</h1>
    <button type="button" class="btn btn-light refresh" data-refresh>Оновити</button>
  </div>

  <div class="tabs" role="tablist" aria-label="Статус заявок">
    <button type="button" role="tab" data-tab="new" aria-selected="true">Нові <span data-tab-count="new"></span></button>
    <button type="button" role="tab" data-tab="work" aria-selected="false">В роботі <span data-tab-count="work"></span></button>
    <button type="button" role="tab" data-tab="done" aria-selected="false">Виконані</button>
    <button type="button" role="tab" data-tab="cancelled" aria-selected="false">Скасовані</button>
    <button type="button" role="tab" data-tab="all" aria-selected="false">Усі</button>
  </div>

  <p class="state" data-state="loading">Завантаження…</p>
  <div class="alert" role="alert" tabindex="-1" data-state="error" hidden></div>
  <p class="state empty" data-state="empty" hidden>Тут поки порожньо.</p>
  <ul class="list" data-state="list" hidden></ul>
  <p class="list-msg" role="status" data-list-msg></p>

  <template data-card>
    <li class="req">
      <div class="req-head">
        <b class="num" data-num></b>
        <span class="date" data-date></span>
        <label class="status">
          <span class="sr-only">Статус</span>
          <select data-status>
            <option value="new">🆕 Нова</option>
            <option value="contacted">📞 Зв'язались</option>
            <option value="paid">💶 Оплачено</option>
            <option value="shipped">📦 Відправлено</option>
            <option value="done">✅ Виконано</option>
            <option value="cancelled">✖ Скасовано</option>
          </select>
        </label>
      </div>
      <div class="req-body">
        <div class="who">
          <b data-name></b>
          <span class="contact"><span data-method></span>: <a data-contact-link></a></span>
          <span class="muted" data-where></span>
          <p class="comment" data-comment hidden></p>
        </div>
        <ul class="items" data-items></ul>
        <p class="total"><span class="promo-used" data-promo hidden></span>Разом: <b data-total></b></p>
      </div>
      <details class="note">
        <summary>Нотатка для команди <span class="has-note" data-has-note hidden>•</span></summary>
        <textarea rows="3" maxlength="2000" data-note placeholder="Напр.: оплатила на картку, відправити в п'ятницю"></textarea>
        <button type="button" class="btn btn-light" data-save-note>Зберегти нотатку</button>
      </details>
      <button type="button" class="delete" data-delete hidden>Видалити заявку</button>
      <p class="row-msg" role="status" data-row-msg></p>
    </li>
  </template>
</Admin>

<script>
  import { requireStaff, supabase, formatMoney, dbError, type Localized } from '../../lib/admin';

  type Item = { slug: string; name: Localized; price: number; qty: number };
  type Req = {
    id: number; created_at: string; status: string; locale: string; name: string; method: string; contact: string;
    country: string; delivery: string; comment: string; currency: string; total: number; items: Item[]; staff_note: string;
    promo_code: string | null; discount: number;
  };

  const TABS: Record<string, string[]> = {
    new: ['new'], work: ['contacted', 'paid', 'shipped'], done: ['done'], cancelled: ['cancelled'],
    all: ['new', 'contacted', 'paid', 'shipped', 'done', 'cancelled'],
  };
  const METHOD: Record<string, string> = { call: 'Дзвінок', telegram: 'Telegram', viber: 'Viber', whatsapp: 'WhatsApp', email: 'Email' };
  const DELIVERY: Record<string, string> = {
    discuss: 'обговорити', inpost: 'InPost', dpd: 'DPD', dhl: 'DHL', orlen: 'Orlen Paczka', 'poczta-polska': 'Poczta Polska',
    'nova-poshta': 'Нова пошта', ukrposhta: 'Укрпошта', 'courier-wroclaw': "кур'єр по Вроцлаву",
  };
  const regions = new Intl.DisplayNames(['uk'], { type: 'region' });
  const dateFmt = new Intl.DateTimeFormat('uk', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const states = [...document.querySelectorAll<HTMLElement>('[data-state]')];
  const show = (name: string) => states.forEach((s) => (s.hidden = s.dataset.state !== name));
  let tab = 'new';
  let rows: Req[] = [];

  /** Посилання, яке одразу відкриває потрібний месенджер чи дзвінок. */
  function contactHref(r: Req): string {
    const digits = r.contact.replace(/[^\d+]/g, '');
    if (r.method === 'email') return `mailto:${r.contact}`;
    if (r.method === 'telegram') return /^@?[A-Za-z0-9_]{5,32}$/.test(r.contact) ? `https://t.me/${r.contact.replace(/^@/, '')}` : `https://t.me/${digits}`;
    if (r.method === 'whatsapp') return `https://wa.me/${digits.replace(/^\+/, '')}`;
    if (r.method === 'viber') return `viber://chat?number=${encodeURIComponent(digits)}`;
    return `tel:${digits}`;
  }

  async function load() {
    show('loading');
    const { data, error } = await supabase!.from('requests')
      .select('id,created_at,status,locale,name,method,contact,country,delivery,comment,currency,total,items,staff_note,promo_code,discount')
      .order('created_at', { ascending: false }).limit(500);
    if (error) { $('[data-state="error"]').textContent = dbError(error); return show('error'); }
    rows = data as Req[];
    render();
  }

  let isOwner = false;

  function render() {
    for (const t of ['new', 'work']) {
      const n = rows.filter((r) => TABS[t]!.includes(r.status)).length;
      $(`[data-tab-count="${t}"]`).textContent = n ? String(n) : '';
    }
    document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
    const visible = rows.filter((r) => TABS[tab]!.includes(r.status));
    const tpl = $<HTMLTemplateElement>('[data-card]');
    $('[data-state="list"]').replaceChildren(...visible.map((r) => {
      const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
      const q = <T extends HTMLElement = HTMLElement>(s: string) => li.querySelector<T>(s)!;
      li.dataset.requestId = String(r.id);
      li.dataset.status = r.status;
      q('[data-num]').textContent = `№ ${r.id}`;
      q('[data-date]').textContent = dateFmt.format(new Date(r.created_at));
      q<HTMLSelectElement>('[data-status]').value = r.status;
      q('[data-name]').textContent = r.name;
      q('[data-method]').textContent = METHOD[r.method] ?? r.method;
      const link = q<HTMLAnchorElement>('[data-contact-link]');
      link.textContent = r.contact;
      link.href = contactHref(r);
      if (link.href.startsWith('http')) { link.target = '_blank'; link.rel = 'noopener'; }
      q('[data-where]').textContent = `${regions.of(r.country) ?? r.country} · доставка: ${DELIVERY[r.delivery] ?? r.delivery} · мова сайту: ${r.locale.toUpperCase()}`;
      if (r.comment) { q('[data-comment]').textContent = `«${r.comment}»`; q('[data-comment]').hidden = false; }
      q('[data-items]').replaceChildren(...r.items.map((it) => {
        const row = document.createElement('li');
        const name = it.name.uk || it.name.pl || Object.values(it.name)[0] || it.slug;
        row.textContent = `${name} × ${it.qty} — ${formatMoney(it.price * it.qty)} ${r.currency}`;
        return row;
      }));
      q('[data-total]').textContent = `${formatMoney(r.total)} ${r.currency}`;
      q('[data-promo]').hidden = !r.promo_code;
      q('[data-promo]').textContent = r.promo_code ? `Промокод ${r.promo_code}: −${formatMoney(r.discount)} ${r.currency} · ` : '';
      q<HTMLTextAreaElement>('[data-note]').value = r.staff_note;
      q('[data-has-note]').hidden = !r.staff_note;
      // Видалення — лише власник (RLS), напр. коли покупець просить стерти свої дані (GDPR).
      // Тільки скасовані й виконані: інакше зарезервований товар не повернувся б на склад.
      q('[data-delete]').hidden = !isOwner;
      q('[data-delete]').addEventListener('click', async () => {
        if (!['cancelled', 'done'].includes(r.status)) {
          q('[data-row-msg]').textContent = 'Спершу змініть статус на «Скасовано» (товар повернеться на склад) або «Виконано».';
          return;
        }
        if (!confirm(`Видалити заявку № ${r.id} назавжди разом з даними покупця?`)) return;
        const { error } = await supabase!.from('requests').delete().eq('id', r.id);
        if (error) { q('[data-row-msg]').textContent = dbError(error); return; }
        rows = rows.filter((x) => x.id !== r.id);
        render();
        $('[data-list-msg]').textContent = `Заявку № ${r.id} видалено.`;
      });

      q<HTMLSelectElement>('[data-status]').addEventListener('change', async (e) => {
        const sel = e.currentTarget as HTMLSelectElement;
        const next = sel.value;
        if (next === 'cancelled' && !confirm(`Скасувати заявку № ${r.id}? Товар повернеться на склад.`)) { sel.value = r.status; return; }
        sel.disabled = true;
        const { error } = await supabase!.from('requests').update({ status: next }).eq('id', r.id);
        sel.disabled = false;
        if (error) {
          sel.value = r.status;
          q('[data-row-msg]').textContent = error.message?.includes('stock') ? 'Не можна відновити: товару вже не вистачає на складі.' : dbError(error);
          return;
        }
        r.status = next;
        q('[data-row-msg]').textContent = 'Статус збережено ✓';
        li.dataset.status = next;
        render();
      });
      q('[data-save-note]').addEventListener('click', async () => {
        const note = q<HTMLTextAreaElement>('[data-note]').value.trim();
        const { error } = await supabase!.from('requests').update({ staff_note: note }).eq('id', r.id);
        if (error) { q('[data-row-msg]').textContent = dbError(error); return; }
        r.staff_note = note;
        q('[data-has-note]').hidden = !note;
        q('[data-row-msg]').textContent = 'Нотатку збережено ✓';
      });
      return li;
    }));
    show(visible.length ? 'list' : 'empty');
  }

  document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((b) => b.addEventListener('click', () => { tab = b.dataset.tab!; render(); }));
  $('[data-refresh]').addEventListener('click', load);

  requireStaff().then((me) => { isOwner = me.role === 'owner'; return load(); }).catch(() => {});
</script>

<style>
  .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  h1 { font-size: 28px; font-weight: 900; }
  .refresh { border: 2px solid var(--accent-border); }
  .tabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 16px 0; }
  .tabs button { min-height: 40px; padding: 6px 16px; border: 2px solid var(--line); border-radius: 999px; background: var(--surface); font-weight: 800; cursor: pointer; }
  .tabs button[aria-selected='true'] { border-color: var(--pink-600); background: var(--accent-soft); color: var(--accent-text); }
  .tabs span:not(:empty) { margin-left: 4px; padding: 0 7px; border-radius: 999px; background: var(--pink-600); color: #fff; font-size: 12px; }
  [data-state][hidden] { display: none; }
  .state { color: var(--ink-2); font-weight: 700; }
  .alert { padding: 12px 16px; border-radius: var(--radius-sm); background: var(--tint-red); border: 2px solid var(--tint-red-border); font-weight: 700; }

  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .req { padding: 18px; background: var(--surface); border: 1px solid var(--line); border-left: 6px solid var(--line); border-radius: var(--radius); display: grid; gap: 10px; }
  .req[data-status='new'] { border-left-color: var(--pink-600); }
  .req[data-status='done'] { border-left-color: var(--green); }
  .req[data-status='cancelled'] { opacity: 0.75; }
  .req-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .num { font-size: 18px; }
  .date { color: var(--ink-2); font-weight: 600; }
  .status { margin-left: auto; }
  .status select { min-height: 40px; padding: 6px 12px; border: 2px solid var(--line); border-radius: 12px; background: var(--surface); font-weight: 800; }
  .req-body { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 8px 24px; }
  .who { display: grid; gap: 2px; }
  .contact a { color: var(--accent-text); font-weight: 800; text-decoration: underline; overflow-wrap: anywhere; }
  .muted { color: var(--ink-2); font-size: 14px; font-weight: 600; }
  .comment { margin: 6px 0 0; font-style: italic; }
  .comment[hidden] { display: none; }
  .items { margin: 0; padding-left: 18px; font-weight: 600; }
  .total { margin: 0; grid-column: 2; text-align: right; font-size: 18px; }
  .promo-used { font-size: 15px; color: var(--accent-text); font-weight: 800; }
  .promo-used[hidden] { display: none; }
  .note summary { cursor: pointer; font-weight: 800; color: var(--ink-2); }
  .has-note { color: var(--pink-600); }
  .has-note[hidden] { display: none; }
  .note textarea { width: 100%; margin: 8px 0; padding: 10px 12px; border: 2px solid var(--line); border-radius: 12px; background: var(--surface); }
  .row-msg { margin: 0; font-weight: 700; color: var(--ink-2); }
  .row-msg:empty { display: none; }
  @media (max-width: 720px) { .req-body { grid-template-columns: 1fr; } .total { grid-column: 1; } }
  .delete { justify-self: start; border: 0; background: none; padding: 4px 0; color: var(--sale); font-weight: 800; cursor: pointer; text-decoration: underline; }
  .delete[hidden] { display: none; }
  .list-msg { font-weight: 700; color: var(--ink-2); }
  .list-msg:empty { display: none; }
</style>

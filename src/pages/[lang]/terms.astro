---
// Регламент магазину (Terms of Sale): модель «заявка → підтвердження → оплата напряму». Шаблон, не юридична консультація.
// Текст — src/legal/<мова>/terms.html (оригінал англійською, переклади: npm run legal:translate).
import LegalDoc from '../../components/legal/LegalDoc.astro';
import { LOCALES, type Locale } from '../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
---
<LegalDoc locale={Astro.params.lang as Locale} doc="terms" titleKey="footer.terms" />

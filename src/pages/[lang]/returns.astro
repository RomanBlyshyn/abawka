---
// Повернення: право відмови 14 днів (Директива 2011/83/ЄС, польський Закон про права споживача)
// і типова форма відмови з додатка до закону.
import LegalDoc from '../../components/legal/LegalDoc.astro';
import Seller from '../../components/legal/Seller.astro';
import Fill from '../../components/legal/Fill.astro';
import { LOCALES, type Locale } from '../../i18n/config';
import { href } from '../../lib/format';
import { shop } from '../../lib/shop';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const a = shop.address;
---
<LegalDoc locale={locale} titleKey="footer.returns" heading="Returns and right of withdrawal">
  <h2>In short</h2>
  <ul>
    <li>You have <b>14 days</b> from receiving the parcel to change your mind, without giving a reason.</li>
    <li>Tell the seller, then send the goods back within 14 days. <b>You pay for sending them back.</b></li>
    <li>We refund the price and the original standard delivery cost within 14 days.</li>
    <li>Faulty goods are a different case — see <a href={href(locale, 'terms/')}>complaints in the Terms of Sale</a>; then the seller pays for the return.</li>
  </ul>

  <h2>Right of withdrawal</h2>
  <p>If you are a consumer, you have the right to withdraw from the contract within 14 days without giving any reason. The withdrawal period expires 14 days from the day on which you, or a person indicated by you other than the carrier, receive the goods. If the order arrives in several parcels, the period counts from the day you receive the last one.</p>
  <p>To exercise the right of withdrawal, inform the seller of your decision by a clear statement — an email, a message or a letter to:</p>
  <Seller />
  <p>You may use the model withdrawal form below, but it is not obligatory. It is enough to send your statement before the 14-day period has expired.</p>

  <h2>Sending the goods back</h2>
  <p>Send the goods back to <b>{shop.seller}, {a.street}, <Fill value={a.postcode} label="postcode" /> {a.city}, {a.country}</b> without undue delay and no later than 14 days from the day you informed us of your withdrawal. You bear the direct cost of returning the goods.</p>
  <p>You may unpack and check the toy as you would in a shop. You are only liable for any diminished value of the goods resulting from handling beyond what is necessary to establish their nature, characteristics and functioning.</p>

  <h2>Refund</h2>
  <p>We will refund all payments received from you, including the cost of delivery (except the extra cost if you chose a delivery method other than the cheapest standard delivery we offered), without undue delay and no later than 14 days from the day we receive your withdrawal statement. We use the same payment method you used, unless you agree otherwise; you will not pay any fees for the refund. We may withhold the refund until we have received the goods back or you have supplied proof of having sent them, whichever is earlier.</p>

  <h2 id="form">Model withdrawal form</h2>
  <p>(Complete and return this form only if you wish to withdraw from the contract.)</p>
  <div class="form-copy">
    <p>To: <b>{shop.seller}</b>, {a.street}, <Fill value={a.postcode} label="postcode" /> {a.city}, {a.country}, email: <Fill value={shop.email} label="email" /></p>
    <p>I/We (*) hereby give notice that I/We (*) withdraw from my/our (*) contract of sale of the following goods:</p>
    <p class="line">…</p>
    <p>Ordered on (*) / received on (*): …</p>
    <p>Name of consumer(s): …</p>
    <p>Address of consumer(s): …</p>
    <p>Signature of consumer(s) (only if this form is sent on paper): …</p>
    <p>Date: …</p>
    <p class="small">(*) Delete as appropriate.</p>
  </div>
</LegalDoc>

<style>
  .form-copy { padding: 16px 20px; border: 2px dashed var(--line); border-radius: var(--radius-sm); }
  .form-copy .small { font-size: 14px; color: var(--ink-2); }
</style>

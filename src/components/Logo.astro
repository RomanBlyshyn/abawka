---
// Векторна версія горизонтального лого клієнта (docs/brand/logo-horizontal.jpg): голова ведмедика + кольорові літери.
// Кольори літер — у стилях нижче (nth-child), щоб не було інлайн-стилів.
const LETTERS = ['A', 'B', 'A', 'W', 'K', 'A'];
---
<span class="logo">
  <svg class="bear" viewBox="0 0 48 44" aria-hidden="true">
    <circle cx="9" cy="10" r="8" fill="#f5a623" /><circle cx="9" cy="10" r="4" fill="#e8912a" />
    <circle cx="39" cy="10" r="8" fill="#f5a623" /><circle cx="39" cy="10" r="4" fill="#e8912a" />
    <circle cx="24" cy="24" r="19" fill="#f5a623" />
    <ellipse cx="24" cy="30" rx="9" ry="7" fill="#fcd59a" />
    <circle cx="17" cy="21" r="2.2" fill="#4a2c1a" /><circle cx="31" cy="21" r="2.2" fill="#4a2c1a" />
    <ellipse cx="24" cy="27" rx="3" ry="2.2" fill="#4a2c1a" />
    <path d="M19.5 31.5q4.5 4 9 0" stroke="#4a2c1a" stroke-width="2" fill="none" stroke-linecap="round" />
  </svg>
  <span class="word">{LETTERS.map((ch) => <span>{ch}</span>)}</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 6px; }
  .bear { width: 38px; height: 35px; flex: none; }
  .word { font-weight: 900; font-size: 28px; letter-spacing: 0.5px; line-height: 1; }
  .word span:nth-child(1), .word span:nth-child(4) { color: #e53935; }
  .word span:nth-child(2), .word span:nth-child(3) { color: #43a047; }
  .word span:nth-child(5) { color: #1e88e5; }
  .word span:nth-child(6) { color: #fb8c00; }
  @media (max-width: 380px) { .word { font-size: 24px; } .bear { width: 32px; } }
</style>

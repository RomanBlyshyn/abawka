---
// Хто продавець і як з ним зв'язатися — однаково в усіх юридичних документах.
import Fill from './Fill.astro';
import { shop } from '../../lib/shop';
const a = shop.address;
---
<address class="seller">
  <b>{shop.seller}</b><br />
  {a.street}, <Fill value={a.postcode} label="postcode" /> {a.city}, {a.country}<br />
  Email: <Fill value={shop.email} label="email" href={shop.email ? `mailto:${shop.email}` : undefined} /><br />
  Phone: <Fill value={shop.phone} label="phone" href={shop.phone ? `tel:${shop.phone.replace(/\s/g, '')}` : undefined} />
</address>

<style>
  .seller { font-style: normal; padding: 14px 18px; border-left: 4px solid var(--accent-border); background: var(--accent-soft); border-radius: var(--radius-sm); }
</style>

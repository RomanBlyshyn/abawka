---
// Юридичний документ мовою сайту. Оригінал — англійською; інші мови — переклад для зручності з посиланням на оригінал.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n';
import { href } from '../../lib/format';
import { legalHtml, type LegalDoc } from '../../lib/legal';

interface Props { locale: Locale; doc: LegalDoc; titleKey: string }
const { locale, doc, titleKey } = Astro.props;
const t = useTranslations(locale);
const html = legalHtml(doc, locale, { todo: t('legal.todo'), email: t('legal.email'), phone: t('legal.phone') });
---
<Base locale={locale} title={t(titleKey)}>
  <div class="wrap legal-doc">
    <Breadcrumbs locale={locale} items={[{ label: t(titleKey) }]} />
    {locale !== 'en' && (
      <p class="note">{t('legal.translated')} <a href={href('en', `${doc}/`)} hreflang="en" lang="en">{t('legal.englishVersion')}</a></p>
    )}
    <article set:html={html} />
  </div>
</Base>

<style>
  .legal-doc { max-width: 780px; padding-bottom: 40px; }
  .note { padding: 10px 14px; border-radius: var(--radius-sm); background: var(--surface); border: 2px solid var(--line); font-weight: 700; }
  .note a { color: var(--accent-text); text-decoration: underline; }
  article { line-height: 1.65; overflow-wrap: break-word; hyphens: auto; } /* довгі слова (рос. «конфиденциальности») на 320px */
  article :global(h1) { font-size: clamp(28px, 5vw, 38px); font-weight: 900; margin: 12px 0 4px; }
  article :global(h2) { font-size: 21px; font-weight: 900; margin: 28px 0 8px; }
  article :global(p), article :global(ul), article :global(ol) { margin: 0 0 12px; }
  article :global(ul), article :global(ol) { padding-left: 22px; }
  article :global(li) { margin-bottom: 6px; }
  article :global(a) { color: var(--accent-text); text-decoration: underline; }
  article :global(.updated) { color: var(--ink-2); font-weight: 600; }
  article :global(.seller) { font-style: normal; margin-bottom: 12px; padding: 14px 18px; border-left: 4px solid var(--accent-border); background: var(--accent-soft); border-radius: var(--radius-sm); }
  article :global(.todo) { padding: 0 4px; border-radius: 4px; background: var(--tint-yellow); outline: 2px dashed var(--ink-2); color: inherit; font-weight: 800; }
  article :global(.form-copy) { padding: 16px 20px; border: 2px dashed var(--line); border-radius: var(--radius-sm); }
  article :global(.form-copy .small) { font-size: 14px; color: var(--ink-2); }
</style>

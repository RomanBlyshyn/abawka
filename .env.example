# Скопіюй у .env і заповни. Сам .env у git не потрапляє. Секрети — тільки сюди, не в чат і не в код.

# ── Supabase: Project Settings → API ──────────────────────────────
# Публічні (можна у фронт і в чат):
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Секретні (тільки тут):
SUPABASE_SERVICE_ROLE_KEY=
# Пароль бази, який ти задав при створенні проєкту (для застосування міграцій):
SUPABASE_DB_PASSWORD=

# ── DeepL API Free: deepl.com → Account → API Keys ────────────────
DEEPL_API_KEY=

# ── Пізніше ───────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=        # етап 3, бот створює клієнт у @BotFather
# Netlify → Site configuration → Build & deploy → Build hooks → Add build hook. Потім npm run fn:secrets.
# NETLIFY_BUILD_HOOK_URL=
# Адреса сайту на хостингу (для посилань у Telegram-повідомленнях), напр. https://abawka.pl
# SITE_URL=
